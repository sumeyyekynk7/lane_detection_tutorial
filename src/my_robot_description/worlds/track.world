                        </box>
                    </geometry>

                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                    </material>
                </visual>

                <!-- 8. çizgi -->
                <visual name="center_line_8">
                    <pose>6 0 0.04 0 0 0</pose>

                    <geometry>
                        <box>
                            <size>1.0 0.08 0.02</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                    </material>
                </visual>

                <!-- 9. çizgi -->
                <visual name="center_line_9">
                    <pose>8 0 0.04 0 0 0</pose>

                    <geometry>
                        <box>
                            <size>1.0 0.08 0.02</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                    </material>
                </visual>

            </link>

        </model>

    </world>

</sdf>